<header class="stock-page-heading"><div><p class="stock-eyebrow">A HOME FOR EVERY PRODUCT</p><h1>Products</h1><p>Keep your catalog organized and your stock in view.</p></div><a class="stock-button primary" href="/inventory/products/add"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add product</a></header>
<section class="stock-panel">
  <div class="stock-panel-heading"><div><h2>Your inventory <span class="stock-count"><%= products.length %></span></h2><p>Search, filter, and manage every item.</p></div><a class="stock-button secondary" href="/inventory/restock"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> Restock products</a></div>
  <div class="stock-filter-bar">
    <label class="stock-search"><i class="bi bi-search" aria-hidden="true"></i><input id="searchInput" type="search" placeholder="Search products or suppliers" aria-label="Search products"></label>
    <select id="categoryFilter" class="form-select" aria-label="Filter by category"><option value="">All categories</option><% [...new Set(products.map(product => product.category))].sort().forEach(category => { %><option value="<%= category %>"><%= categoryLabel(category) %></option><% }); %></select>
    <select id="stockFilter" class="form-select" aria-label="Filter by stock status"><option value="">All stock levels</option><option value="in-stock">In stock</option><option value="low-stock">Low stock</option><option value="out-of-stock">Out of stock</option></select>
    <button id="resetFilters" class="stock-button secondary" type="button">Reset</button>
  </div>
  <%- include('../partials/product-table', { products, allowDelete: true, showPrice: true }) %>
  <div class="stock-table-footer"><span><%= products.length %> products in your inventory</span><span>Prices in INR</span></div>
</section>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="deleteTitle">Delete this product?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><strong id="productName"></strong> and its restock history will be removed.</div><div class="modal-footer"><button type="button" class="stock-button secondary" data-bs-dismiss="modal">Keep product</button><form id="deleteForm" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="stock-button danger">Delete product</button></form></div></div></div></div>
<script src="/js/products.js" defer></script>
