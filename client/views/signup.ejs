<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create an account · Stockroom Inventory</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-story" aria-label="Stockroom Inventory">
      <a class="stockroom-brand" href="/"><i class="bi bi-stack" aria-hidden="true"></i> Stockroom<span>.</span></a>
      <div><h1>Everything in its place.</h1><p>A clearer picture of your inventory. Keep products, suppliers, and stock movements together in one workspace.</p></div>
      <small>Less searching. More knowing.</small>
    </section>
    <section class="auth-form" aria-labelledby="authTitle">
      <p class="stock-eyebrow">STOCKROOM INVENTORY</p><h2 id="authTitle">Create an account</h2>
      <p class="stock-muted">Set up your inventory workspace.</p>
      <% if (errorMessage) { %><p class="alert alert-danger" role="alert"><%= errorMessage %></p><% } %>
      <form id="signupForm" action="/signup" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3"><label for="name" class="form-label">Full name</label><input type="text" id="name" name="name" class="form-control" autocomplete="name" maxlength="100" required><div class="invalid-feedback">Please enter your name.</div></div>
        <div class="mb-3"><label for="email" class="form-label">Email address</label><input type="email" id="email" name="email" class="form-control" autocomplete="email" placeholder="you@company.com" required><div class="invalid-feedback">Please enter your email.</div></div>
        <div class="mb-4"><label for="password" class="form-label">Password</label><input type="password" id="password" name="password" class="form-control" autocomplete="new-password" minlength="8" required><div class="invalid-feedback">Please enter your password.</div><div class="form-text">Use at least 8 characters.</div></div>
        <button type="submit" class="stock-button primary">Create account <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
      </form>
      <div class="auth-divider">or continue with</div>
      <%- include('partials/google-button', { label: 'Sign up with Google' }) %>
      <p class="auth-switch">Already have an account? <a href="/">Sign in</a></p>
    </section>
  </main>
  <script src="/js/signup-1.js" defer></script>
</body>
</html>
