<header class="stock-page-heading"><div><p class="stock-eyebrow">EVERYTHING IN ITS PLACE</p><h1>Inventory overview</h1><p>A clear view of what’s stocked and what needs attention.</p></div><a class="stock-button primary" href="/inventory/products/add"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add product</a></header>
<div class="stock-metrics">
  <section class="stock-metric"><span>Products</span><strong><%= dashboardData.total_products %></strong><small>Across <%= dashboardData.total_categories %> categories</small></section>
  <section class="stock-metric"><span>Units on hand</span><strong><%= Number(dashboardData.total_stock).toLocaleString('en-US') %></strong><small>Across your inventory</small></section>
  <section class="stock-metric"><span>Need attention</span><strong><%= dashboardData.lowStockProducts.length %></strong><small>Below 10 units</small></section>
</div>
<section class="stock-panel">
  <div class="stock-panel-heading"><div><h2>Your products</h2><p>Up to 8 recent products, with low stock first.</p></div><button class="stock-button secondary" type="button" id="attentionFilter" aria-pressed="false"><i class="bi bi-filter" aria-hidden="true"></i> Needs attention</button></div>
  <label class="stock-search overview-search"><i class="bi bi-search" aria-hidden="true"></i><input id="overviewSearch" type="search" placeholder="Search products or suppliers" aria-label="Search overview products"></label>
  <%- include('partials/product-table', { products: dashboardData.products, allowDelete: false, showPrice: false }) %>
  <div class="stock-table-footer"><span id="overviewCount" data-total="<%= dashboardData.total_products %>" aria-live="polite"><%= dashboardData.products.length %> of <%= dashboardData.total_products %> products</span><a href="/inventory/products">View all products <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
</section>
<details class="stock-breakdown"><summary>Inventory breakdown <span><%= dashboardData.total_suppliers %> suppliers · <%= dashboardData.total_categories %> categories</span></summary><div class="stock-charts"><section><h2>Category distribution</h2><div class="chart-container"><canvas id="categoryChart" aria-label="Product distribution by category" role="img"></canvas></div></section><section><h2>Stock levels</h2><div class="chart-container"><canvas id="stockLevelChart" aria-label="Products by stock level" role="img"></canvas></div></section></div></details>
<script src="/vendor/chart.js"></script>
<script id="dashboard-data" type="application/json"><%- jsonForScript({ categoryDistribution: dashboardData.categoryDistribution, stockLevels: dashboardData.stockLevels }) %></script>
<script src="/js/dashboard.js" defer></script>
<script src="/js/overview.js" defer></script>
