<header class="workspace-header">
  <div class="workspace-breadcrumb"><button class="stock-icon-button mobile-nav-toggle" type="button" id="toggleNavigation" aria-label="Toggle navigation" aria-controls="workspaceSidebar" aria-expanded="false"><i class="bi bi-list" aria-hidden="true"></i></button><span>Workspace</span><span class="breadcrumb-divider">/</span><strong><%= title %></strong></div>
  <div class="header-actions"><a class="stock-icon-button notification-link" href="/inventory/reports" aria-label="<%= lowStockCount %> products need attention"><i class="bi bi-bell" aria-hidden="true"></i><% if (lowStockCount) { %><span class="notification-dot"></span><% } %></a><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="stock-icon-button" type="submit" aria-label="Sign out"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></button></form><a class="workspace-avatar small" href="/inventory/profile" aria-label="Your profile"><%= (user.name || 'U').slice(0,1).toUpperCase() %></a></div>
</header>
