<aside class="workspace-sidebar" id="workspaceSidebar" aria-label="Workspace sidebar">
  <a class="stockroom-brand" href="/dashboard"><i class="bi bi-stack" aria-hidden="true"></i> Stockroom<span>.</span></a>
  <span class="sidebar-caption">WORKSPACE</span>
  <nav class="workspace-nav" aria-label="Main navigation">
    <% const links = [
      { label: 'Overview', href: '/dashboard', icon: 'bi-grid-1x2', active: currentPath === '/dashboard' },
      { label: 'Products', href: '/inventory/products', icon: 'bi-box-seam', active: currentPath.startsWith('/inventory/products') },
      { label: 'Suppliers', href: '/inventory/suppliers', icon: 'bi-truck', active: currentPath.startsWith('/inventory/suppliers') },
      { label: 'Restock', href: '/inventory/restock', icon: 'bi-box-arrow-in-down', active: currentPath === '/inventory/restock' },
      { label: 'Reports', href: '/inventory/reports', icon: 'bi-bar-chart-line', active: currentPath === '/inventory/reports' },
      { label: 'Sales history', href: '/inventory/sales', icon: 'bi-receipt', active: currentPath === '/inventory/sales' }
    ]; %>
    <% links.forEach(link => { %><a href="<%= link.href %>" class="workspace-nav-link <%= link.active ? 'is-active' : '' %>" <%- link.active ? 'aria-current="page"' : '' %>><i class="bi <%= link.icon %>" aria-hidden="true"></i><%= link.label %></a><% }); %>
  </nav>
  <div class="sidebar-bottom">
    <a class="workspace-nav-link <%= currentPath.startsWith('/inventory/settings') ? 'is-active' : '' %>" href="/inventory/settings/profile"><i class="bi bi-sliders2" aria-hidden="true"></i> Settings</a>
    <div class="settings-shortcuts"><a href="/inventory/settings/security">Security</a><a href="/inventory/settings/preferences">Preferences</a></div>
    <a class="sidebar-profile" href="/inventory/profile"><span class="workspace-avatar"><%= (user.name || 'U').slice(0,1).toUpperCase() %></span><span><strong><%= user.name %></strong><small>Inventory workspace</small></span></a>
  </div>
</aside>
