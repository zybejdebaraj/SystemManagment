

    <!-- Edit supplier container -->
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1 fw-bold">Edit Supplier</h2>
                <p class="text-muted">Update supplier information</p>
            </div>
            <a href="/inventory/suppliers" class="btn btn-outline-secondary fw-bold">
                <i class="bi bi-arrow-left me-2"></i>Back to Suppliers
            </a>
        </div>
        <div class="card">
            <div class="card-body">
                <form action="/inventory/suppliers/edit/<%= supplier.id %>" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-bold">Supplier Name</label>
                        <input type="text" class="form-control" id="name" name="name" value="<%= supplier.name %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="contact" class="form-label fw-bold">Contact</label>
                        <input type="tel" class="form-control" id="contact" name="contact" value="<%= supplier.contact %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" id="email" name="email" value="<%= supplier.email %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label fw-bold">Address</label>
                        <textarea class="form-control" id="address" name="address" required><%= supplier.address %></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary fw-bold">Update Supplier</button>
                    <a href="/inventory/suppliers" class="btn btn-secondary fw-bold">Cancel</a>
                </form>
            </div>
        </div>
    </div>
